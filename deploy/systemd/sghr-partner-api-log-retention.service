[Unit]
Description=SGHR Partner API Log Retention
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=sghr
Group=sghr
WorkingDirectory=/opt/sghr
EnvironmentFile=/opt/sghr/.env
Environment=PYTHONPATH=/opt/sghr
ExecStart=/opt/sghr/venv/bin/python /opt/sghr/scripts/cleanup_partner_api_logs.py

NoNewPrivileges=true
PrivateTmp=true
