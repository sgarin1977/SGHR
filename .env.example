ENVIRONMENT=local
BOT_TOKEN=
BOT_USERNAME=
BOT_DROP_PENDING_UPDATES=false
ADMIN_TELEGRAM_IDS=123456789,987654321
DEFAULT_LANGUAGE=ru
DEFAULT_TENANT_ID=

DATABASE_URL=
CONSTRUCTION_DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

LOG_LEVEL=INFO

# Root Recovery security
ROOT_SECURITY_ENCRYPTION_KEY=
ROOT_TOTP_ISSUER=SGHR Root Recovery
ROOT_PASSWORD_MIN_LENGTH=14
ROOT_PASSWORD_MAX_ATTEMPTS=5
ROOT_MFA_MAX_ATTEMPTS=5
ROOT_AUTH_COOLDOWN_SECONDS=900
ROOT_SESSION_TTL_SECONDS=900
ROOT_ACTION_TTL_SECONDS=300
ROOT_RECOVERY_CODE_COUNT=10

TRANSLATION_PROVIDER=libretranslate
TRANSLATION_BASE_URL=http://127.0.0.1:5000
TRANSLATION_API_KEY=
TRANSLATION_TIMEOUT_SECONDS=15
TRANSLATION_MAX_RETRIES=3
TRANSLATION_CACHE_ENABLED=true

GEO_MODE=haversine
BETA_MODE=private

MANUAL_PAYMENT_INSTRUCTIONS_RU=
MANUAL_PAYMENT_INSTRUCTIONS_EN=
MANUAL_PAYMENT_INSTRUCTIONS_PT=
MANUAL_PAYMENT_APPROVAL_THRESHOLD_EUR=100
SUPABASE_STORAGE_BUCKET=specialist-portfolio
SUPABASE_STORAGE_SIGNED_URL_TTL_SECONDS=900
NOMINATIM_CACHE_TTL_SECONDS=3600
NOMINATIM_CACHE_MAX_ENTRIES=512

API_JWT_SECRET=
API_JWT_ISSUER=sghr-api
API_JWT_AUDIENCE=sghr-core
API_ACCESS_TOKEN_TTL_SECONDS=900
API_REFRESH_TOKEN_TTL_SECONDS=2592000
API_TELEGRAM_AUTH_MAX_AGE_SECONDS=300

API_EMAIL_AUTH_SECRET=
API_EMAIL_AUTH_CODE_TTL_SECONDS=600
API_EMAIL_AUTH_MAX_ATTEMPTS=5
API_EMAIL_AUTH_REQUEST_LIMIT=5
API_EMAIL_AUTH_REQUEST_WINDOW_SECONDS=900


EMAIL_PROVIDER=resend
EMAIL_FROM=
WEB_APP_URL=
MOBILE_DEEP_LINK_SCHEME=sghr
EMAIL_AUTH_TOKEN_TTL=600
RESEND_API_KEY=

# Partner API
API_ENVIRONMENT=sandbox


# Shared stable Fernet key: API and invitation worker must use the same value.
# Reuse the existing runtime key if configured; do not rotate it during deployment.
# Generate once with cryptography.fernet.Fernet.generate_key(); retain across restarts.
# Never commit a real key. This installer does not edit the real .env.
API_IDEMPOTENCY_ENCRYPTION_KEY=

# Existing frontend invitation recipient page: HTTPS, same origin as WEB_APP_URL.
# Required explicitly: no recipient route is assumed or created by this worker.
CONSTRUCTION_INVITATION_RECIPIENT_PAGE_URL=
CONSTRUCTION_INVITATION_EMAIL_LANGUAGE=en
CONSTRUCTION_INVITATION_WORKER_POLL_SECONDS=1
CONSTRUCTION_INVITATION_WORKER_LEASE_SECONDS=120
CONSTRUCTION_INVITATION_WORKER_JOB_TIMEOUT_SECONDS=30
# Deployment validates with --check-config, then starts the dedicated service.
# External email delivery is at-least-once if a process dies after sending before commit.
